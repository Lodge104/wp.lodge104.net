option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /var/www/html
    memory_limit: 256M
    max_execution_time: 300
    display_errors: "Off"
    allow_url_fopen: "On"
    
  aws:elasticbeanstalk:application:environment:
    COMPOSER_HOME: /root

# PHP extensions are included in the Amazon Linux 2023 PHP solution stack
# Additional extensions can be installed via yum if needed
# Note: Package names may vary by PHP version (e.g., php-mysqlnd, php8.3-mysqlnd)
packages:
  yum:
    php-mysqlnd: []
    php-xml: []
    php-mbstring: []
    php-gd: []
    php-zip: []
    php-bcmath: []
    php-intl: []

files:
  "/etc/php.d/99-wordpress.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      ; WordPress PHP Configuration
      upload_max_filesize = 64M
      post_max_size = 64M
      memory_limit = 256M
      max_execution_time = 300
      max_input_time = 300
      max_input_vars = 3000
