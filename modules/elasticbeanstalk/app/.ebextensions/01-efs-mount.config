packages:
  yum:
    amazon-efs-utils: []
    nfs-utils: []

commands:
  01_create_mount_point:
    command: "mkdir -p /var/www/efs"
    ignoreErrors: true
  02_mount_efs:
    command: |
      if ! mountpoint -q /var/www/efs; then
        EFS_ID=$(cat /opt/elasticbeanstalk/deployment/env | grep EFS_FILE_SYSTEM_ID | cut -d'=' -f2)
        # Use IMDSv2 for enhanced security
        TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
        REGION=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/region)
        if [ -z "$REGION" ]; then
          echo "Failed to retrieve region from IMDS, using fallback"
          REGION="us-east-1"
        fi
        mount -t efs -o tls $EFS_ID:/ /var/www/efs || { echo "EFS mount failed"; exit 1; }
        echo "$EFS_ID:/ /var/www/efs efs defaults,_netdev,tls 0 0" >> /etc/fstab
      fi
    ignoreErrors: false
  03_create_wordpress_dir:
    command: "mkdir -p /var/www/efs/wordpress"
    ignoreErrors: true
  04_set_permissions:
    command: "chown -R webapp:webapp /var/www/efs"
    ignoreErrors: true
