# Copy this file to variables.pkrvars.hcl and adjust as needed.
# Usage: packer build -var-file=variables.pkrvars.hcl wordpress.pkr.hcl

aws_region      = "us-east-1"
instance_type   = "t3.small"
ami_name_prefix = "lodge104-wordpress"

# A public subnet (with IGW route) for the Packer build instance.
# Obtain after running: cd ../terraform && terraform apply -target=... (see below)
subnet_id = "subnet-REPLACE_ME"
