packages:
  yum:
    amazon-efs-utils: []

commands:
  01_create_mount_dir:
    command: "mkdir -p /var/www/efs"
  02_mount_efs:
    command: |
      #!/bin/bash
      source /opt/elasticbeanstalk/deployment/env || true
      FS_ID="${EFS_FILE_SYSTEM_ID}"
      MNT="/var/www/efs"
      if mountpoint -q "$MNT"; then
        echo "EFS already mounted at $MNT"
        exit 0
      fi
      if [ -n "$FS_ID" ]; then
        mount -t efs -o tls "$FS_ID":/ "$MNT" || exit 1
        if ! grep -q "$FS_ID" /etc/fstab; then
          echo "$FS_ID:/ $MNT efs defaults,_netdev,tls 0 0" >> /etc/fstab
        fi
      else
        echo "EFS_FILE_SYSTEM_ID not set" >&2
        exit 1
      fi
  03_permissions:
    command: "chown -R webapp:webapp /var/www/efs && chmod 755 /var/www/efs"
