packages:
  yum:
    amazon-efs-utils: []

commands:
  01_create_efs_mount_dir:
    command: "mkdir -p /mnt/efs"
  02_mount_efs:
    command: |
      #!/bin/bash
      EFS_ID="${EFS_FILE_SYSTEM_ID}"
      MNT="/mnt/efs"
      
      # Check if already mounted
      if mountpoint -q "$MNT"; then
        echo "EFS already mounted"
        exit 0
      fi
      
      # Mount with TLS
      mount -t efs -o tls "${EFS_ID}":/ "$MNT"
      
      # Add to fstab for persistence
      if ! grep -q "${EFS_ID}" /etc/fstab; then
        echo "${EFS_ID}:/ ${MNT} efs defaults,_netdev,tls 0 0" >> /etc/fstab
      fi
  03_set_permissions:
    command: "chown -R webapp:webapp /mnt/efs"
  04_create_symlink:
    command: "ln -sf /mnt/efs/wordpress /var/www/html/wordpress"
    test: "[ ! -L /var/www/html/wordpress ]"

files:
  "/etc/nginx/conf.d/wordpress.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      location / {
          try_files $uri $uri/ /index.php?$args;
      }

option_settings:
  aws:elasticbeanstalk:application:environment:
    DOCUMENT_ROOT: /wordpress
