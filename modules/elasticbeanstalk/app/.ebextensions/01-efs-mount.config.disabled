packages:
  yum:
    amazon-efs-utils: []

commands:
  01_create_efs_mount_dir:
    command: "mkdir -p /var/www/efs"
  02_mount_efs_filesystem:
    command: |
      #!/bin/bash
      # Get EFS ID from environment file if it exists
      if [ -f /opt/elasticbeanstalk/deployment/env ]; then
        source /opt/elasticbeanstalk/deployment/env
      fi
      
      FS_ID="${EFS_FILE_SYSTEM_ID}"
      MNT="/var/www/efs"
      
      echo "Attempting to mount EFS: $FS_ID to $MNT"
      
      if mountpoint -q "$MNT"; then
        echo "EFS already mounted at $MNT"
        exit 0
      fi
      
      if [ -z "$FS_ID" ]; then
        echo "ERROR: EFS_FILE_SYSTEM_ID not set" >&2
        exit 1
      fi
      
      mount -t efs -o tls "$FS_ID":/ "$MNT"
      if [ $? -ne 0 ]; then
        echo "ERROR: Failed to mount EFS $FS_ID" >&2
        exit 1
      fi
      
      if ! grep -q "$FS_ID" /etc/fstab; then
        echo "$FS_ID:/ $MNT efs defaults,_netdev,tls 0 0" >> /etc/fstab
      fi
      
      echo "EFS mounted successfully"
  03_set_efs_permissions:
    command: "chown -R webapp:webapp /var/www/efs && chmod 755 /var/www/efs"
