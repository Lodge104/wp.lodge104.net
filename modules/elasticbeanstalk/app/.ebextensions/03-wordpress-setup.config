commands:
  00_prepare_wp_dir:
    command: |
      #!/bin/bash
      mkdir -p /var/www/efs/wordpress
      chown -R webapp:webapp /var/www/efs
      chmod 755 /var/www/efs
      ls -la /var/www/efs/wordpress || true
container_commands:
  01_install_wordpress:
    command: |
      #!/bin/bash
      set -e
      echo "[WP-SETUP] Starting WordPress setup"
      source /opt/elasticbeanstalk/deployment/env || true
      echo "[WP-SETUP] DB_HOST=$DB_HOST DB_NAME=$DB_NAME DB_USER=$DB_USER"
      WP_DIR="/var/www/efs/wordpress"
      HTML_DIR="/var/www/html"
      mkdir -p "$WP_DIR"
      if [ ! -f "$WP_DIR/wp-config.php" ]; then
        echo "[WP-SETUP] Installing WordPress into $WP_DIR"
        cd /tmp
        curl -sS -O https://wordpress.org/latest.tar.gz
        tar -xzf latest.tar.gz
        cp -r wordpress/* "$WP_DIR/"
        rm -rf latest.tar.gz wordpress
        cp "$WP_DIR/wp-config-sample.php" "$WP_DIR/wp-config.php"
        sed -i "s/database_name_here/$DB_NAME/g" "$WP_DIR/wp-config.php"
        sed -i "s/username_here/$DB_USER/g" "$WP_DIR/wp-config.php"
        sed -i "s/password_here/$DB_PASSWORD/g" "$WP_DIR/wp-config.php"
        sed -i "s/localhost/$DB_HOST/g" "$WP_DIR/wp-config.php"
        sed -i "/put your unique phrase here/d" "$WP_DIR/wp-config.php"
        echo "/* Custom WordPress Configuration */" >> "$WP_DIR/wp-config.php"
        echo "define('FS_METHOD', 'direct');" >> "$WP_DIR/wp-config.php"
        echo "define('WP_DEBUG', false);" >> "$WP_DIR/wp-config.php"
        echo "/* WordPress Multi-site Configuration */" >> "$WP_DIR/wp-config.php"
        echo "define('WP_ALLOW_MULTISITE', true);" >> "$WP_DIR/wp-config.php"
        echo "define('MULTISITE', true);" >> "$WP_DIR/wp-config.php"
        echo "define('SUBDOMAIN_INSTALL', true);" >> "$WP_DIR/wp-config.php"
        echo "define('DOMAIN_CURRENT_SITE', '$PRIMARY_DOMAIN');" >> "$WP_DIR/wp-config.php"
        echo "define('PATH_CURRENT_SITE', '/');" >> "$WP_DIR/wp-config.php"
        echo "define('SITE_ID_CURRENT_SITE', 1);" >> "$WP_DIR/wp-config.php"
        echo "define('BLOG_ID_CURRENT_SITE', 1);" >> "$WP_DIR/wp-config.php"
        echo "define('COOKIE_DOMAIN', '.$PRIMARY_DOMAIN');" >> "$WP_DIR/wp-config.php"
        if [ -n "$REDIS_HOST" ]; then
          echo "/* Redis Object Cache Configuration */" >> "$WP_DIR/wp-config.php"
          echo "define('WP_REDIS_HOST', '$REDIS_HOST');" >> "$WP_DIR/wp-config.php"
          echo "define('WP_REDIS_PORT', $REDIS_PORT);" >> "$WP_DIR/wp-config.php"
          echo "define('WP_REDIS_DATABASE', 0);" >> "$WP_DIR/wp-config.php"
          echo "define('WP_REDIS_TIMEOUT', 1);" >> "$WP_DIR/wp-config.php"
          echo "define('WP_REDIS_READ_TIMEOUT', 1);" >> "$WP_DIR/wp-config.php"
          echo "define('WP_CACHE', true);" >> "$WP_DIR/wp-config.php"
          if [ -n "$REDIS_AUTH_TOKEN" ]; then
            echo "define('WP_REDIS_PASSWORD', '$REDIS_AUTH_TOKEN');" >> "$WP_DIR/wp-config.php"
          fi
        fi
        echo "[WP-SETUP] WordPress installation completed"
      else
        echo "[WP-SETUP] WordPress already installed"
      fi
      echo "[WP-SETUP] Linking $HTML_DIR -> $WP_DIR"
      rm -rf "$HTML_DIR" 2>/dev/null || true
      ln -sfn "$WP_DIR" "$HTML_DIR"
      chown -R webapp:webapp "$WP_DIR"
      chmod -R 755 "$WP_DIR"
      ls -la "$WP_DIR" | sed 's/^/[WP-SETUP] /'
      if [ -f "$WP_DIR/wp-config.php" ]; then echo "[WP-SETUP] wp-config.php present"; else echo "[WP-SETUP] wp-config.php MISSING"; fi
