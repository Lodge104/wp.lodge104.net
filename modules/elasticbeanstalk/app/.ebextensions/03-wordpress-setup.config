files:
  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_install_wordpress.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      
      # Get environment variables
      source /opt/elasticbeanstalk/deployment/env
      
      # WordPress directory on EFS
      WP_DIR="/var/www/efs/wordpress"
      HTML_DIR="/var/www/html"
      
      # Check if WordPress is already installed
      if [ ! -f "$WP_DIR/wp-config.php" ]; then
        echo "Installing WordPress..."
        
        # Download WordPress
        cd /tmp
        curl -O https://wordpress.org/latest.tar.gz
        tar -xzf latest.tar.gz
        
        # Copy WordPress files to EFS
        cp -r wordpress/* $WP_DIR/
        rm -rf latest.tar.gz wordpress
        
        # Create wp-config.php
        cp $WP_DIR/wp-config-sample.php $WP_DIR/wp-config.php
        
        # Configure database connection
        sed -i "s/database_name_here/$DB_NAME/g" $WP_DIR/wp-config.php
        sed -i "s/username_here/$DB_USER/g" $WP_DIR/wp-config.php
        sed -i "s/password_here/$DB_PASSWORD/g" $WP_DIR/wp-config.php
        sed -i "s/localhost/$DB_HOST/g" $WP_DIR/wp-config.php
        
        # Add additional WordPress configurations
        cat >> $WP_DIR/wp-config.php << 'EOF'
      
      /* Custom WordPress Configuration */
      define('FS_METHOD', 'direct');
      define('WP_DEBUG', false);
      
      /* WordPress Multi-site Configuration */
      define('WP_ALLOW_MULTISITE', true);
      define('MULTISITE', true);
      define('SUBDOMAIN_INSTALL', true);
      EOF
        
        # Add domain-specific configuration
        echo "define('DOMAIN_CURRENT_SITE', '$PRIMARY_DOMAIN');" >> $WP_DIR/wp-config.php
        echo "define('PATH_CURRENT_SITE', '/');" >> $WP_DIR/wp-config.php
        echo "define('SITE_ID_CURRENT_SITE', 1);" >> $WP_DIR/wp-config.php
        echo "define('BLOG_ID_CURRENT_SITE', 1);" >> $WP_DIR/wp-config.php
        echo "define('COOKIE_DOMAIN', '.$PRIMARY_DOMAIN');" >> $WP_DIR/wp-config.php
        
        # Configure Redis if available
        if [ ! -z "$REDIS_HOST" ]; then
          cat >> $WP_DIR/wp-config.php << EOF
      
      /* Redis Object Cache Configuration */
      define('WP_REDIS_HOST', '$REDIS_HOST');
      define('WP_REDIS_PORT', $REDIS_PORT);
      define('WP_REDIS_DATABASE', 0);
      define('WP_REDIS_TIMEOUT', 1);
      define('WP_REDIS_READ_TIMEOUT', 1);
      define('WP_CACHE', true);
      EOF
          
          if [ ! -z "$REDIS_AUTH_TOKEN" ]; then
            echo "define('WP_REDIS_PASSWORD', '$REDIS_AUTH_TOKEN');" >> $WP_DIR/wp-config.php
          fi
        fi
        
        # Generate WordPress salts
        SALTS=$(curl -s https://api.wordpress.org/secret-key/1.1/salt/)
        sed -i '/AUTH_KEY/,/NONCE_SALT/d' $WP_DIR/wp-config.php
        echo "$SALTS" >> $WP_DIR/wp-config.php
        
        echo "WordPress installation completed."
      else
        echo "WordPress already installed."
      fi
      
      # Create symlink from web root to WordPress
      rm -rf $HTML_DIR 2>/dev/null || true
      ln -sfn $WP_DIR $HTML_DIR
      
      # Set proper permissions
      chown -R webapp:webapp $WP_DIR
      chmod -R 755 $WP_DIR
      
      echo "WordPress setup complete."
